      <mxCell id="m1" value="1. Upload citra CXR" style="endArrow=block;html=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="90" y="180" as="sourcePoint"/><mxPoint x="310" y="180" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m2" value="2. POST /api/predict (file + Bearer token)" style="endArrow=block;html=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="310" y="240" as="sourcePoint"/><mxPoint x="542" y="240" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m3" value="3. Verifikasi token, role, status, STR/SIP" style="endArrow=block;html=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="542" y="300" as="sourcePoint"/><mxPoint x="765" y="300" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m4" value="4. Akses disetujui" style="endArrow=open;dashed=1;html=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="765" y="350" as="sourcePoint"/><mxPoint x="542" y="350" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m5" value="5. Validasi Chest X-Ray" style="endArrow=block;html=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="542" y="415" as="sourcePoint"/><mxPoint x="1002" y="415" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m6" value="6. Hasil validasi Gemini Vision" style="endArrow=open;dashed=1;html=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1002" y="465" as="sourcePoint"/><mxPoint x="542" y="465" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m7" value="7. Validasi CLIP (jika Gemini pass)" style="endArrow=block;html=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="542" y="525" as