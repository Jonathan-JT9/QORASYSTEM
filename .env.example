# =============================================================================
# QORA — environment template
# Copy this file to `.env` in the project root AND/OR `frontend/.env`
# Never commit real keys.
# =============================================================================

# --- Flask backend ---
FLASK_ENV=development
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
CORS_ORIGINS=http://localhost:5173

# Path to HQCNN checkpoint (relative to backend/ or absolute)
CHECKPOINT_PATH=checkpoints/best.pt
MODEL_DEVICE=auto

# --- Google Gemini (clinical interpretation) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Frontend (Vite) — put these in frontend/.env as well ---
VITE_API_BASE_URL=http://localhost:5000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
